# Keep this repository limited to reviewed application files.
# New root-level folders/files stay local until explicitly allowed below.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/app.py
!/desktop.py
!/requirements_desktop.txt
!/requirements_windows.txt
!/启动工具.cmd
!/启动工具.vbs
!/启动旧版界面.cmd
!/启动旧版界面.vbs
!/准备桌面环境.cmd

!/meeting_tool/
/meeting_tool/*
!/meeting_tool/*.py
!/tests/
/tests/*
!/tests/test_*.py
!/scripts/
/scripts/*
!/scripts/check_publish.py
!/scripts/windows/
/scripts/windows/*
!/scripts/windows/README.md
!/scripts/windows/build_windows.py
!/scripts/windows/prepare_vendor_manifest.py
!/scripts/windows/tingji.spec
!/scripts/windows/tingji.iss

!/assets/
/assets/*
!/assets/tingji.svg
!/assets/tingji.png
!/assets/tingji.ico

# Only the reviewed, fictional-data documentation screenshots may be shared.
!/docs/
/docs/*
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/transcript.png
!/docs/screenshots/summary.png
!/docs/screenshots/review.png

!/web/
/web/*
!/web/package.json
!/web/package-lock.json
!/web/index.html
!/web/vite.config.ts
!/web/tsconfig.json
!/web/components.json
!/web/COMPONENT-SOURCES.txt
!/web/SHADCN-LICENSE.txt
!/web/src/
!/web/src/**
!/web/dist/
!/web/dist/**

# Privacy exclusions apply even inside an allowed source directory.
**/settings.json
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.runtime/
**/.venv/
**/venv/
**/node_modules/
**/__pycache__/
**/.ai_summary_cache/
**/cache/
**/work/
**/转写结果/
**/人物试听片段/
**/checkpoint.json
**/analysis.json
**/review_annotations.json
**/speaker_names.json
**/AI总结.*
**/完整转写.*
*.py[cod]
*.tsbuildinfo
*.log
*.tmp
*.wav
*.mp3
*.m4a
*.aac
*.ogg
*.opus
*.flac
*.wma
*.amr
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.zip
*.7z
*.rar
*.sqlite*
*.db
*.pt
*.pth
*.onnx
*.safetensors

